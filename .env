# Local development defaults (docker compose up). Override them in .env.local or in the hosting environment.
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=telemetry
POSTGRES_SSLMODE=disable
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DATABASE}?schema=public&sslmode=${POSTGRES_SSLMODE}"

# When set, creating or renaming an app through the API needs `Authorization: Bearer <token>`.
TELEMETRY_ADMIN_TOKEN=
